+    __shared__ float temp[WARPS];
+    if (lane == 0) temp[warp] = ss;
+    __syncthreads();
+    float tot = (lane < WARPS) ? temp[lane] : 0.0f;
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) tot += __shfl_down_sync(0xffffffffu, tot, o);
+    __shared__ float total_s;
+    if (tid == 0) total_s = tot;
+    __syncthreads();
