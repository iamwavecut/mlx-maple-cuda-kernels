+            float xv[VALUES_PER_LANE];
+            #pragma unroll
+            for (int i = 0; i < VALUES_PER_LANE; ++i) {
+                xv[i] = static_cast<float>(x[col + i]);
+            }
+            #pragma unroll
+            for (int row = 0; row < ROWS_PER_WARP; ++row) {
